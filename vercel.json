{
  "version": 2,
  "functions": {
    "api/image.js": { "maxDuration": 120 }
  },
  "routes": [
    {
      "src": "/api/generate",
      "dest": "/api/generate.js"
    },
    {
      "src": "/api/image",
      "dest": "/api/image.js"
    },
    {
      "src": "/api/pdf",
      "dest": "/api/pdf.js"
    },
    {
      "src": "/api/email",
      "dest": "/api/email.js"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}